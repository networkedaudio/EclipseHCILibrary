@page "/mib-browser"
@inject ConfigurationService ConfigService
@inject SnmpBrowserService BrowserService
@inject EclipseHxMatrixStatus MatrixStatus

<h1>MIB Browser</h1>

<!-- Connection status -->
<div class="config-section" style="margin-bottom: 16px; padding: 12px 16px;">
    <strong>Local SNMP Agent:</strong>
    <span>port 10161</span>
    &nbsp;|&nbsp;
    <strong>Cards:</strong> @MatrixStatus.GetCardsSnapshot().Count
    &nbsp;|&nbsp;
    <strong>Ports:</strong> @MatrixStatus.GetPortsSnapshot().Count
    &nbsp;|&nbsp;
    <strong>Last card update:</strong> @(MatrixStatus.LastCardUpdate?.ToString("HH:mm:ss") ?? "never")
    &nbsp;|&nbsp;
    <strong>Last PSU update:</strong> @(MatrixStatus.LastPsuUpdate?.ToString("HH:mm:ss") ?? "never")
</div>

<div class="browser-toolbar">
    <label>Target:</label>
    <select @bind="_targetMode">
        <option value="local">Local Agent (localhost:10161)</option>
        <option value="remote">Remote Matrix</option>
    </select>

    @if (_targetMode == "remote")
    {
        <label>Matrix:</label>
        <select @bind="_selectedIndex">
            <option value="-1">— Select a matrix —</option>
            @for (int i = 0; i < ConfigService.Configuration.Matrices.Count; i++)
            {
                var matrix = ConfigService.Configuration.Matrices[i];
                <option value="@i">@matrix.Name (@matrix.IpAddress)</option>
            }
        </select>
    }

    <label>Base OID:</label>
    <input type="text" @bind="_baseOid" placeholder="1.3.6.1.4.1.99999.1" />

    <button class="btn" @onclick="WalkAsync" disabled="@_loading">
        @(_loading ? "Walking..." : "Walk")
    </button>

    <button class="btn btn-secondary" @onclick="RefreshAsync" disabled="@(_loading || _tree == null)">
        Refresh
    </button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="error-message">@_error</div>
}

@if (!string.IsNullOrEmpty(_status))
{
    <div class="status-message">@_status</div>
}

@if (_tree != null)
{
    <div class="mib-tree">
        <MibTreeView Node="_tree" />
    </div>
}
else if (!_loading)
{
    <p class="muted">Click Walk to browse the MIB tree. Use "Local Agent" to see data collected from matrices via HCI.</p>
}

@code {
    private string _targetMode = "local";
    private int _selectedIndex = -1;
    private string _baseOid = EclipseHxOids.Base;
    private MibTreeNode? _tree;
    private bool _loading;
    private string _error = string.Empty;
    private string _status = string.Empty;

    private async Task WalkAsync()
    {
        _error = string.Empty;
        _loading = true;
        _status = "Walking MIB tree...";
        StateHasChanged();

        try
        {
            MatrixConnection target;

            if (_targetMode == "local")
            {
                target = new MatrixConnection
                {
                    Name = "Local Agent",
                    IpAddress = "127.0.0.1",
                    Port = 10161,
                    Community = "public"
                };
            }
            else
            {
                if (_selectedIndex < 0 || _selectedIndex >= ConfigService.Configuration.Matrices.Count)
                {
                    _error = "Please select a matrix.";
                    _loading = false;
                    return;
                }
                target = ConfigService.Configuration.Matrices[_selectedIndex];
            }

            _tree = await BrowserService.WalkAsync(target, _baseOid);

            var leafCount = CountLeaves(_tree);
            _status = leafCount > 0
                ? $"Walk complete — {leafCount} value(s) retrieved at {DateTime.Now:HH:mm:ss}"
                : $"Walk complete — no values found. Is the HCI polling service connected to a matrix?";
        }
        catch (Exception ex)
        {
            _error = $"SNMP Walk failed: {ex.Message}";
            _status = string.Empty;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        await WalkAsync();
    }

    private static int CountLeaves(MibTreeNode node)
    {
        if (node.IsLeaf) return 1;
        int count = 0;
        foreach (var child in node.Children)
            count += CountLeaves(child);
        return count;
    }
}
