@page "/dynamic"
@using BeltpackManager.Services
@using HCILibrary.HCIResponses
@using HCILibrary.HCIRequests
@using HCILibrary.Models
@using HCILibrary.Enums
@using System.Diagnostics
@inject HCIService HCIService
@inject IConfiguration Configuration
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Dynamic Monitor</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Dynamic Monitor</MudText>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

@if (!isConnected && !loading)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">Not connected to matrix</MudAlert>
}

<div class="d-flex justify-space-between align-center mb-4">
    <div></div>
    <div class="d-flex gap-2">
        <MudButton Variant="@(bulkAddRunning ? Variant.Filled : Variant.Outlined)"
                   Color="@(bulkAddRunning ? Color.Warning : Color.Secondary)"
                   OnClick="BulkAddTestAsync"
                   Disabled="!isConnected || loading || bulkAddRunning"
                   StartIcon="@Icons.Material.Filled.PlaylistAdd">
            @(bulkAddRunning ? $"Adding... {bulkAddProgress}/200" : "Bulk Add 200 (Test)")
        </MudButton>
        <MudButton Variant="@(acceptAllActive ? Variant.Filled : Variant.Outlined)" 
                   Color="@(acceptAllActive ? Color.Success : Color.Default)" 
                   OnClick="ToggleAcceptAll" 
                   Disabled="!isConnected || loading"
                   StartIcon="@(acceptAllActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.AddCircleOutline)">
            @(acceptAllActive ? "Accepting Beltpacks..." : "Accept All Beltpacks")
        </MudButton>
    </div>
</div>

@if (acceptAllActive)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Watching for new beltpack Pin Check messages. New beltpacks will be automatically added with a fixed role assignment.
        <strong>@acceptedCount</strong> beltpack(s) accepted so far.
    </MudAlert>
}

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.h5">Active Beltpacks</MudText>
                <div>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" 
                                   OnClick="RefreshBeltpacksAsync" 
                                   Disabled="!isConnected || loading"
                                   Title="Refresh beltpacks" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                   OnClick="ClearBeltpacks" 
                                   Title="Clear table" />
                </div>
            </div>
            <MudTable Items="@activeBeltpacks.Values.OrderBy(b => b.RoleNumber)" 
                      Hover="true" 
                      Striped="true" 
                      Dense="true" 
                      Loading="@loading"
                      FixedHeader="true"
                      Height="400px">
                <HeaderContent>
                    <MudTh>PMID</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Antenna</MudTh>
                    <MudTh>Online Since</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="PMID">@context.PmidHex</MudTd>
                    <MudTd DataLabel="Role">@context.RoleNumber</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@(context.IsOnline ? Color.Success : Color.Default)" Size="Size.Small">
                            @(context.IsOnline ? "Online" : "Offline")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Antenna">@context.AntennaPort</MudTd>
                    <MudTd DataLabel="Online Since">@(context.OnlineSince?.ToString("HH:mm:ss") ?? "-")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>@(loading ? "Loading..." : "No active beltpacks")</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.h5">Event Log</MudText>
                <div>
                    <MudTextField @bind-Value="searchPhrase" 
                                  Label="Filter phrase" 
                                  Variant="Variant.Outlined" 
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Style="width: 200px;"
                                  Class="mr-2" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                   OnClick="ClearLog" 
                                   Title="Clear log" />
                    <MudSwitch @bind-Value="autoScroll" 
                               Label="Auto-scroll" 
                               Color="Color.Primary" 
                               Class="ml-2" />
                </div>
            </div>
            <div id="log-container" 
                 style="height: 400px; overflow-y: auto; background-color: #1e1e1e; border-radius: 4px; padding: 8px; font-family: 'Consolas', 'Courier New', monospace; font-size: 12px;"
                 @ref="logContainer">
                @foreach (var entry in GetFilteredLogEntries())
                {
                    <div style="color: @entry.Color; margin-bottom: 2px; white-space: pre-wrap;">
                        <span style="color: #808080;">[@entry.Timestamp.ToString("HH:mm:ss.fff")]</span> @entry.Message
                    </div>
                }
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mt-4" Elevation="2">
    <MudText Typo="Typo.h5" Class="mb-2">Statistics</MudText>
    <MudGrid>
        <MudItem xs="3">
            <MudText><strong>Total Events:</strong> @logEntries.Count</MudText>
        </MudItem>
        <MudItem xs="3">
            <MudText><strong>Active Beltpacks:</strong> @activeBeltpacks.Values.Count(b => b.IsOnline)</MudText>
        </MudItem>
        <MudItem xs="3">
            <MudText><strong>Total Tracked:</strong> @activeBeltpacks.Count</MudText>
        </MudItem>
        <MudItem xs="3">
            <MudText><strong>Connected:</strong> @(isConnected ? "Yes" : "No")</MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private bool loading = true;
    private bool isConnected = false;
    private string? errorMessage;
    private bool autoScroll = true;
    private string searchPhrase = string.Empty;
    private ElementReference logContainer;

    private Dictionary<uint, TrackedBeltpack> activeBeltpacks = new();
    private List<LogEntry> logEntries = new();
    private const int MaxLogEntries = 1000;

    // Bulk add test feature
    private bool bulkAddRunning = false;
    private int bulkAddProgress = 0;

    // Accept all beltpacks feature
    private bool acceptAllActive = false;
    private int acceptedCount = 0;
    private HashSet<uint> knownSerials = new();
    private HashSet<uint> pendingSerials = new();
    private List<RoleStateEntry> availableRoles = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Subscribe to HCI messages
            HCIService.MessageReceived += OnMessageReceived;
            HCIService.ConnectionStateChanged += OnConnectionStateChanged;

            // Connect and start listening
            await ConnectAsync();
        }

        // Auto-scroll to bottom
        if (autoScroll && logEntries.Count > 0)
        {
            try
            {
                await ScrollToBottom();
            }
            catch
            {
                // Ignore scroll errors
            }
        }
    }

    private async Task ConnectAsync()
    {
        try
        {
            var matrixIp = Configuration["MatrixIP"] ?? "192.168.1.100";
            Debug.WriteLine($"[Dynamic] ConnectAsync called. MatrixIP={matrixIp}, HCIService.IsConnected={HCIService.IsConnected}");
            AddLogEntry($"Connecting to matrix at {matrixIp}...", LogLevel.Info);

            if (!HCIService.IsConnected)
            {
                isConnected = await HCIService.ConnectAsync(matrixIp);
                Debug.WriteLine($"[Dynamic] ConnectAsync result: isConnected={isConnected}");

                if (!isConnected)
                {
                    errorMessage = $"Failed to connect to matrix at {matrixIp}";
                    AddLogEntry($"Connection failed: {matrixIp}", LogLevel.Error);
                    loading = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
            else
            {
                isConnected = true;
                Debug.WriteLine($"[Dynamic] Already connected, skipping ConnectAsync");
            }

            AddLogEntry("Connected! Listening for HCI messages...", LogLevel.Success);
            loading = false;
            await InvokeAsync(StateHasChanged);

            // Load known beltpacks and roles for accept-all feature
            await LoadKnownBeltpacksAndRolesAsync();

            // Request initial beltpack status
            Debug.WriteLine($"[Dynamic] About to call RefreshBeltpacksAsync");
            await RefreshBeltpacksAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Connection error: {ex.Message}";
            AddLogEntry($"Error: {ex.Message}", LogLevel.Error);
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshBeltpacksAsync()
    {
        try
        {
            Debug.WriteLine($"[Dynamic] RefreshBeltpacksAsync called. activeBeltpacks.Count={activeBeltpacks.Count}");
            AddLogEntry("Requesting beltpack status...", LogLevel.Info);

            var beltpackStatus = await HCIService.GetBeltpackStatusAsync();
            Debug.WriteLine($"[Dynamic] GetBeltpackStatusAsync returned: {(beltpackStatus == null ? "null" : $"Entries.Count={beltpackStatus.Entries.Count}")}");

            if (beltpackStatus != null)
            {
                AddLogEntry($"Received {beltpackStatus.Entries.Count} beltpack status entries from matrix", LogLevel.Success);

                foreach (var entry in beltpackStatus.Entries)
                {
                    Debug.WriteLine($"[Dynamic] Processing status entry: PMID=0x{entry.Pmid:X5}, Role={entry.RoleNumber}, Online={entry.IsOnline}, Antenna={entry.AntennaPort}");
                    var tracked = GetOrCreateTrackedBeltpack(entry.Pmid);
                    tracked.IsOnline = entry.IsOnline;
                    tracked.RoleNumber = entry.RoleNumber;
                    tracked.AntennaPort = entry.AntennaPort;
                    tracked.FrequencyType = entry.FrequencyDescription;
                    tracked.WirelessMode = entry.IsFreeSpeak2 ? "FS2" : "FS1";
                    tracked.LastUpdate = DateTime.Now;

                    if (entry.IsOnline)
                    {
                        tracked.OnlineSince ??= DateTime.Now;
                    }

                    AddLogEntry($"Beltpack: PMID={entry.Pmid:X5}, Role={entry.RoleNumber}, {(entry.IsOnline ? "Online" : "Offline")}, Antenna={entry.AntennaPort}", LogLevel.Info);
                }

                Debug.WriteLine($"[Dynamic] After processing: activeBeltpacks.Count={activeBeltpacks.Count}");
            }
            else
            {
                Debug.WriteLine($"[Dynamic] GetBeltpackStatusAsync returned null!");
                AddLogEntry("No beltpack status received", LogLevel.Warning);
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"[Dynamic] RefreshBeltpacksAsync EXCEPTION: {ex}");
            AddLogEntry($"Error refreshing beltpacks: {ex.Message}", LogLevel.Error);
        }
    }

    private void OnMessageReceived(object? sender, HCIReply reply)
    {
        try
        {
            Debug.WriteLine($"[Dynamic] OnMessageReceived: MessageID=0x{(int)reply.MessageID:X4} ({reply.MessageID}), Flags={reply.Flags}, BeltpackStatus={reply.BeltpackStatus != null}, Event={reply.Event != null}");

            // Handle Broadcast System Messages (Event messages)
            if (reply.MessageID == HCIMessageID.BroadcastSystemMessage && reply.Event != null)
            {
                var eventClass = reply.Event.EventClass;
                var level = eventClass switch
                {
                    HCIEventClass.FatalError => LogLevel.Error,
                    HCIEventClass.NonFatalError => LogLevel.Error,
                    HCIEventClass.Warning => LogLevel.Warning,
                    HCIEventClass.Information => LogLevel.Info,
                    HCIEventClass.Debug => LogLevel.Debug,
                    _ => LogLevel.Info
                };

                AddLogEntry($"[{eventClass}] {reply.Event.Text}", level);

                // Accept all beltpacks: watch for Pin Check messages
                if (acceptAllActive && reply.Event.Text.Contains("Pin Check", StringComparison.OrdinalIgnoreCase))
                {
                    _ = Task.Run(() => HandlePinCheckMessageAsync(reply.Event.Text));
                }

                // Check for specific phrases (customize as needed)
                if (!string.IsNullOrEmpty(searchPhrase) && 
                    reply.Event.Text.Contains(searchPhrase, StringComparison.OrdinalIgnoreCase))
                {
                    AddLogEntry($"*** MATCH FOUND: {reply.Event.Text}", LogLevel.Highlight);
                }
            }

            // Handle Beltpack Status messages
            if (reply.MessageID == HCIMessageID.ReplyBeltpackStatus && reply.BeltpackStatus != null)
            {
                Debug.WriteLine($"[Dynamic] OnMessageReceived: BeltpackStatus with {reply.BeltpackStatus.Entries.Count} entries, M={reply.Flags.M}");
                foreach (var entry in reply.BeltpackStatus.Entries)
                {
                    var tracked = GetOrCreateTrackedBeltpack(entry.Pmid);
                    var wasOnline = tracked.IsOnline;

                    tracked.IsOnline = entry.IsOnline;
                    tracked.RoleNumber = entry.RoleNumber;
                    tracked.AntennaPort = entry.AntennaPort;
                    tracked.FrequencyType = entry.FrequencyDescription;
                    tracked.WirelessMode = entry.IsFreeSpeak2 ? "FS2" : "FS1";
                    tracked.LastUpdate = DateTime.Now;

                    // Track online time
                    if (entry.IsOnline && !wasOnline)
                    {
                        tracked.OnlineSince = DateTime.Now;
                        AddLogEntry($"Beltpack ONLINE: PMID={entry.Pmid:X5}, Role={entry.RoleNumber}, Antenna={entry.AntennaPort}", LogLevel.Success);
                    }
                    else if (!entry.IsOnline && wasOnline)
                    {
                        var duration = tracked.OnlineSince.HasValue 
                            ? DateTime.Now - tracked.OnlineSince.Value 
                            : TimeSpan.Zero;
                        AddLogEntry($"Beltpack OFFLINE: PMID={entry.Pmid:X5}, Role={entry.RoleNumber}, Duration={duration:hh\\:mm\\:ss}", LogLevel.Warning);
                        tracked.OnlineSince = null;
                    }
                    else if (entry.IsOnline)
                    {
                        AddLogEntry($"Beltpack UPDATE: PMID={entry.Pmid:X5}, Role={entry.RoleNumber}, Antenna={entry.AntennaPort}", LogLevel.Info);
                    }
                }

                InvokeAsync(StateHasChanged);
            }

            // Handle Role State messages (unsolicited updates)
            if (reply.MessageID == HCIMessageID.ReplyRoleState && reply.RoleState != null)
            {
                foreach (var role in reply.RoleState.Roles)
                {
                    var statusDesc = role.AllocationStatus switch
                    {
                        RoleAllocationStatus.Free => "Free",
                        RoleAllocationStatus.AllocatedFromPool => "Allocated (Pool)",
                        RoleAllocationStatus.AllocatedFixed => "Allocated (Fixed)",
                        _ => "Unknown"
                    };
                    AddLogEntry($"Role State: Role={role.RoleNumber}, Status={statusDesc}, Port={role.PhysicalPort}", LogLevel.Info);
                }

                InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            AddLogEntry($"Error processing message: {ex.Message}", LogLevel.Error);
        }
    }

    private void OnConnectionStateChanged(object? sender, bool connected)
    {
        isConnected = connected;
        AddLogEntry(connected ? "Connection established" : "Connection lost", connected ? LogLevel.Success : LogLevel.Error);
        InvokeAsync(StateHasChanged);
    }

    private TrackedBeltpack GetOrCreateTrackedBeltpack(uint pmid)
    {
        if (!activeBeltpacks.TryGetValue(pmid, out var tracked))
        {
            tracked = new TrackedBeltpack { Pmid = pmid };
            activeBeltpacks[pmid] = tracked;
        }
        return tracked;
    }

    private void AddLogEntry(string message, LogLevel level)
    {
        var entry = new LogEntry
        {
            Timestamp = DateTime.Now,
            Message = message,
            Level = level,
            Color = level switch
            {
                LogLevel.Error => "#ff6b6b",
                LogLevel.Warning => "#ffd93d",
                LogLevel.Success => "#6bcb77",
                LogLevel.Info => "#4d96ff",
                LogLevel.Debug => "#808080",
                LogLevel.Highlight => "#ff00ff",
                _ => "#ffffff"
            }
        };

        logEntries.Add(entry);

        // Trim log if too large
        while (logEntries.Count > MaxLogEntries)
        {
            logEntries.RemoveAt(0);
        }

        InvokeAsync(StateHasChanged);
    }

    private IEnumerable<LogEntry> GetFilteredLogEntries()
    {
        if (string.IsNullOrWhiteSpace(searchPhrase))
            return logEntries;

        return logEntries.Where(e => 
            e.Message.Contains(searchPhrase, StringComparison.OrdinalIgnoreCase));
    }

    private async Task ScrollToBottom()
    {
        // JavaScript interop would be needed for true auto-scroll
        // For now, we rely on CSS and the browser's default behavior
        await Task.CompletedTask;
    }

    private void ClearLog()
    {
        logEntries.Clear();
        AddLogEntry("Log cleared", LogLevel.Info);
    }

    private void ClearBeltpacks()
    {
        activeBeltpacks.Clear();
        AddLogEntry("Beltpack table cleared", LogLevel.Info);
    }

    public void Dispose()
    {
        acceptAllActive = false;
        HCIService.MessageReceived -= OnMessageReceived;
        HCIService.ConnectionStateChanged -= OnConnectionStateChanged;
    }

    private async Task BulkAddTestAsync()
    {
        bulkAddRunning = true;
        bulkAddProgress = 0;
        int succeeded = 0;
        int failed = 0;

        AddLogEntry("Starting bulk add test: 200 beltpacks, serial 1000-1199, Pool mode", LogLevel.Highlight);

        try
        {
            for (int i = 0; i < 200; i++)
            {
                uint serial = (uint)(1000 + i);
                string name = $"Beltpack {serial}";
                if (name.Length > 15)
                    name = name[..15];

                var request = RequestBeltpackAddRequest.PoolMode(serial, serial, name);
                var result = await HCIService.AddBeltpackAsync(request);

                bulkAddProgress = i + 1;

                if (result != null && result.IsSuccess)
                {
                    succeeded++;
                    if (bulkAddProgress % 10 == 0)
                        AddLogEntry($"Bulk add progress: {bulkAddProgress}/200 ({succeeded} ok, {failed} failed)", LogLevel.Info);
                }
                else
                {
                    failed++;
                    var reason = result?.ResultDescription ?? "No response";
                    AddLogEntry($"Bulk add #{bulkAddProgress} failed (serial {serial}): {reason}", LogLevel.Error);
                }

                await InvokeAsync(StateHasChanged);
            }

            AddLogEntry($"Bulk add complete: {succeeded} succeeded, {failed} failed out of 200", succeeded == 200 ? LogLevel.Success : LogLevel.Warning);
        }
        catch (Exception ex)
        {
            AddLogEntry($"Bulk add error at #{bulkAddProgress}: {ex.Message}", LogLevel.Error);
        }
        finally
        {
            bulkAddRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleAcceptAll()
    {
        acceptAllActive = !acceptAllActive;

        if (acceptAllActive)
        {
            acceptedCount = 0;
            pendingSerials.Clear();
            await LoadKnownBeltpacksAndRolesAsync();
            AddLogEntry($"Accept All Beltpacks ENABLED. {knownSerials.Count} known serial(s), {availableRoles.Count(r => r.AllocationStatus == RoleAllocationStatus.Free)} free role(s).", LogLevel.Success);
        }
        else
        {
            AddLogEntry("Accept All Beltpacks DISABLED.", LogLevel.Warning);
        }
    }

    private async Task LoadKnownBeltpacksAndRolesAsync()
    {
        try
        {
            knownSerials.Clear();

            // Load Map/OTA beltpacks
            var mapOta = await HCIService.GetMapOtaBeltpacksAsync();
            if (mapOta != null)
            {
                foreach (var bp in mapOta.Beltpacks)
                    knownSerials.Add(bp.SerialNumber);
            }

            await Task.Delay(500);

            // Load HCI-added beltpacks
            var hci = await HCIService.GetHciAddedBeltpacksAsync();
            if (hci != null)
            {
                foreach (var bp in hci.Beltpacks)
                    knownSerials.Add(bp.SerialNumber);
            }

            await Task.Delay(500);

            // Load available roles
            var roleState = await HCIService.GetRolesAsync();
            if (roleState != null)
            {
                availableRoles = roleState.Roles.OrderBy(r => r.RoleNumber).ToList();
            }

            AddLogEntry($"Loaded {knownSerials.Count} known beltpack(s) and {availableRoles.Count} role(s) ({availableRoles.Count(r => r.AllocationStatus == RoleAllocationStatus.Free)} free)", LogLevel.Info);
        }
        catch (Exception ex)
        {
            AddLogEntry($"Error loading beltpacks/roles: {ex.Message}", LogLevel.Error);
        }
    }

    private (uint pmid, uint serial)? ParsePinCheckMessage(string text)
    {
        // Format: PP:049FC(018940) 000 Pin Check ,OPEN
        // PMID is hex after "PP:", serial is decimal in parentheses
        var match = System.Text.RegularExpressions.Regex.Match(
            text, @"PP:([0-9A-Fa-f]+)\((\d+)\).*Pin Check");

        if (!match.Success)
            return null;

        if (uint.TryParse(match.Groups[1].Value, System.Globalization.NumberStyles.HexNumber, null, out uint pmid) &&
            uint.TryParse(match.Groups[2].Value, out uint serial))
        {
            return (pmid, serial);
        }

        return null;
    }

    private async Task HandlePinCheckMessageAsync(string text)
    {
        try
        {
            var parsed = ParsePinCheckMessage(text);
            if (parsed == null)
                return;

            var (pmid, serial) = parsed.Value;

            // Skip if already known or already being processed
            if (knownSerials.Contains(serial))
                return;

            lock (pendingSerials)
            {
                if (!pendingSerials.Add(serial))
                    return; // Already being processed
            }

            try
            {
                // Find next free role
                var freeRole = availableRoles.FirstOrDefault(r => r.AllocationStatus == RoleAllocationStatus.Free);
                if (freeRole == null)
                {
                    AddLogEntry($"No free roles available for beltpack serial {serial:D6} (PMID {pmid:X5})", LogLevel.Error);
                    return;
                }

                var roleName = $"BP{serial:D6}";
                if (roleName.Length > 15)
                    roleName = roleName[..15];

                AddLogEntry($"Auto-adding beltpack: Serial={serial:D6}, PMID={pmid:X8}, Role={freeRole.RoleNumber}, Name={roleName}", LogLevel.Highlight);

                var request = RequestBeltpackAddRequest.FixedRoleMode(serial, serial, roleName, freeRole.RoleNumber);
                var result = await HCIService.AddBeltpackAsync(request);

                if (result != null && result.IsSuccess)
                {
                    knownSerials.Add(serial);
                    freeRole.AllocationStatus = RoleAllocationStatus.AllocatedFixed;
                    acceptedCount++;
                    AddLogEntry($"Beltpack {serial:D6} added successfully on role {freeRole.RoleNumber}", LogLevel.Success);
                }
                else
                {
                    var reason = result?.ResultDescription ?? "No response";
                    AddLogEntry($"Failed to add beltpack {serial:D6}: {reason}", LogLevel.Error);
                }

                await InvokeAsync(StateHasChanged);
            }
            finally
            {
                lock (pendingSerials)
                {
                    pendingSerials.Remove(serial);
                }
            }
        }
        catch (Exception ex)
        {
            AddLogEntry($"Error auto-adding beltpack: {ex.Message}", LogLevel.Error);
        }
    }

    public class TrackedBeltpack
    {
        public uint Pmid { get; set; }
        public string PmidHex => $"{Pmid:X5}";
        public string SerialNumber { get; set; } = string.Empty;
        public ushort RoleNumber { get; set; }
        public ushort AntennaPort { get; set; }
        public bool IsOnline { get; set; }
        public string FrequencyType { get; set; } = string.Empty;
        public string WirelessMode { get; set; } = string.Empty;
        public DateTime? OnlineSince { get; set; }
        public DateTime LastUpdate { get; set; } = DateTime.Now;
    }

    public class LogEntry
    {
        public DateTime Timestamp { get; set; }
        public string Message { get; set; } = string.Empty;
        public LogLevel Level { get; set; }
        public string Color { get; set; } = "#ffffff";
    }

    public enum LogLevel
    {
        Debug,
        Info,
        Success,
        Warning,
        Error,
        Highlight
    }
}
